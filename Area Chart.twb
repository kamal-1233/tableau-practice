      <column caption='Sales 2021' datatype='real' name='[Calculation_0581920093204480]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order_Date])=2021 THEN [Sales] END' />
      </column>
      <column caption='Sales 2022' datatype='real' name='[Calculation_0581920093519873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF YEAR([Order_Date])=2022 THEN [Sales] END' />
      </column>
      <column caption='KPI Colours' datatype='string' name='[Calculation_1186927076974592]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; 50000 THEN &apos;Green&apos;&#13;&#10;ELSEIF SUM([Sales]) &lt;= 50000 AND SUM([Sales]) &gt; 10000 THEN &apos;Orange&apos;&#13;&#10;ELSE &apos; Red&apos;&#13;&#10;END' />
      </column>
      <column caption='KPI Bullet' datatype='string' name='[Calculation_1186927082164225]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_0581920093519873]) &gt;= SUM([Calculation_0581920093204480]) THEN &quot;Green&quot;&#13;&#10;ELSE &quot;Red&quot; END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1186927089369093]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Quadrant Colour' datatype='string' name='[Calculation_1186927093010438]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1186927089369093] &gt;= [Parameters].[Parameter 2] and AVG([Discount]) &gt;= [Parameters].[Parameter 1]&#13;&#10;THEN &quot;Upper Right&quot; &#13;&#10;ELSEIF [Calculation_1186927089369093] &gt;= [Parameters].[Parameter 2] and AVG([Discount]) &lt; [Parameters].[Parameter 1]&#13;&#10;THEN &quot;Upper Left&quot;&#13;&#10;ELSEIF [Calculation_1186927089369093] &lt; [Parameters].[Parameter 2] and AVG([Discount]) &gt;= [Parameters].[Parameter 1]&#13;&#10;THEN &quot;Bottom Right&quot; &#13;&#10;ELSE &quot;Bottom left&quot; END' />
      </column>
